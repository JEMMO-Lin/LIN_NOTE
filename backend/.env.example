# ===== 应用配置 =====
APP_NAME=KnowFlow
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# ===== 数据库 =====
# MVP 单机模式：SQLite 单文件，无需外部服务
DATABASE_URL=sqlite+aiosqlite:///./knowflow.db
# 生产环境可切换为 PostgreSQL：
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/knowflow

# ===== Redis（可选，缺失时自动降级为无缓存模式）=====
REDIS_URL=redis://localhost:6379/0

# ===== ChromaDB 向量库（可选，缺失时向量检索降级）=====
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# ===== MinIO 文件存储（可选，MVP 阶段暂不使用）=====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowflow
MINIO_SECURE=false

# ===== JWT 认证 =====
JWT_SECRET_KEY=please-change-this-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== CORS =====
CORS_ORIGINS=["http://localhost:3000"]

# ===== Jina Reader (URL 解析) =====
JINA_API_KEY=

# ===== LLM 路由 =====
LLM_DEFAULT_PROVIDER=openai
LLM_MODEL_FAST=
LLM_MODEL_BALANCED=
LLM_MODEL_QUALITY=
LLM_EMBEDDING_MODEL=text-embedding-3-small

# ===== 自生长 LLM Wiki =====
LLM_WIKI_ENABLED=true
# 同一用户在同一知识库内，第 N 次提问后写入 Wiki；下一次可直接命中
LLM_WIKI_PUBLISH_THRESHOLD=5

# ===== 自定义 OpenAI 兼容服务 =====
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL_FAST=
CUSTOM_MODEL_BALANCED=
CUSTOM_MODEL_QUALITY=
CUSTOM_EMBEDDING_MODEL=

# ===== OpenAI =====
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== DeepSeek =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ===== Moonshot / Kimi =====
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ===== 通义千问 =====
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== Anthropic =====
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ===== Ollama 本地模型 =====
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# ===== Celery（可选，缺失时异步任务不执行）=====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
