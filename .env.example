# Docker Compose production configuration.
# Copy to .env on the ECS host and replace every placeholder before starting.

APP_ENV=production
APP_DEBUG=false

# PostgreSQL (use long random values, do not commit the real .env)
POSTGRES_USER=knowflow
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=knowflow

# MinIO (at least 8 characters; use a separate random password)
MINIO_ROOT_USER=knowflow-minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password

# JWT signing key (at least 32 random characters)
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret

# The public origin(s) users will use. JSON array syntax is required.
CORS_ORIGINS=["https://your-domain.example"]

# Choose one provider and set its key/model. Qwen is convenient for Alibaba Cloud.
LLM_DEFAULT_PROVIDER=qwen
QWEN_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_BALANCED=
LLM_MODEL_QUALITY=
LLM_EMBEDDING_MODEL=text-embedding-v3

# Optional URL extraction service
JINA_API_KEY=

# LLM Wiki
LLM_WIKI_ENABLED=true
LLM_WIKI_PUBLISH_THRESHOLD=5
